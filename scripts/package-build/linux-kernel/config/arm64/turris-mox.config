#
# Turris Mox (Marvell Armada 3720): SPI bus + module bus + LAN switch module.
#
# Merged AFTER the generic config/*.config fragments (see build-kernel.sh),
# because:
#  - CONFIG_SPI is off in the generic arm64 defconfig, and CONFIG_MOXTET
#    (Mox's module bus, "depends on SPI_MASTER && OF") silently disappears
#    without it.
#  - config/10-networking.config disables CONFIG_NET_DSA for all arches;
#    Mox's plug-in LAN switch module needs it, so it must be re-enabled
#    after that fragment, not in the arch base which is merged first.
#

CONFIG_SPI=y
CONFIG_SPI_ARMADA_3700=m
CONFIG_MOXTET=m
CONFIG_NET_DSA=m
CONFIG_NET_DSA_MV88E6XXX=m
