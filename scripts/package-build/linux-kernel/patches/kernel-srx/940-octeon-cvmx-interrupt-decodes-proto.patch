From: VyOS SRX kernel build
Subject: octeon: add missing prototype header for cvmx-interrupt-decodes

cvmx-interrupt-decodes.c defines __cvmx_interrupt_gmxx_rxx_int_en_enable
with no prior prototype, which breaks -Werror=missing-prototypes. Add the
header the shipping tree carries (vendor kernel
arch/mips/include/asm/octeon/cvmx-interrupt-decodes.h) and include it.

---
 arch/mips/cavium-octeon/executive/cvmx-interrupt-decodes.c | 1 +
 arch/mips/include/asm/octeon/cvmx-interrupt-decodes.h      | 6 ++++++
 2 files changed, 7 insertions(+)

diff --git a/arch/mips/cavium-octeon/executive/cvmx-interrupt-decodes.c b/arch/mips/cavium-octeon/executive/cvmx-interrupt-decodes.c
--- a/arch/mips/cavium-octeon/executive/cvmx-interrupt-decodes.c
+++ b/arch/mips/cavium-octeon/executive/cvmx-interrupt-decodes.c
@@ -34,6 +34,7 @@

 #include <asm/octeon/octeon.h>

+#include <asm/octeon/cvmx-interrupt-decodes.h>
 #include <asm/octeon/cvmx-gmxx-defs.h>
 #include <asm/octeon/cvmx-pcsx-defs.h>
 #include <asm/octeon/cvmx-pcsxx-defs.h>
diff --git a/arch/mips/include/asm/octeon/cvmx-interrupt-decodes.h b/arch/mips/include/asm/octeon/cvmx-interrupt-decodes.h
new file mode 100644
--- /dev/null
+++ b/arch/mips/include/asm/octeon/cvmx-interrupt-decodes.h
@@ -0,0 +1,6 @@
+#ifndef __CVMX_INTERRUPT_DECODES_H__
+#define __CVMX_INTERRUPT_DECODES_H__
+
+extern void __cvmx_interrupt_gmxx_rxx_int_en_enable(int index, int block);
+
+#endif
--
2.39.5

