@@ -397,7 +414,7 @@
 	uint64_t address =
 	    __cvmx_pcie_build_config_addr(pcie_port, bus, dev, fn, reg);
 	if (address)
-		cvmx_write64_uint16(address, cpu_to_le16(val));
+		cvmx_write64_uint16(CFG_LANE(address, 2), CFG_OUT16(val));
 }
 
