octeon: reset the SRX300 through the CPLD first (933)

About 7% of "systemctl reboot" hung silently after "Restarting system"
(no SPI stage 1 banner) when the board was reset with the bare SoC
RST_SOFT_RST write.  Junos (kernel platform_reset and U-Boot do_reset) clear
bit 1 of CPLD register 0x02 (boot bus CS1 0x1fbf0000) first and only fall back
to RST_SOFT_RST if that returns.  Do the same.  Applies on top of 930.

--- a/arch/mips/cavium-octeon/setup.c
+++ b/arch/mips/cavium-octeon/setup.c
@@ -446,6 +446,23 @@
 {
 	octeon_disable_all_wdogs();
 
+	/*
+	 * SRX300: Junos (kernel and U-Boot) reset the board through the CPLD
+	 * (boot bus CS1, register 0x02 bit 1 cleared) and only fall back to
+	 * RST_SOFT_RST if that returns.  The bare SoC soft reset hangs before
+	 * the SPI stage 1 banner in ~7% of reboots.  The CPLD is
+	 * accessed with a plain volatile byte on uncached xkphys, register r
+	 * sits at offset r ^ 7 (little endian).
+	 */
+	if (of_machine_is_compatible("juniper,srx300")) {
+		volatile u8 *cpld_rst = (volatile u8 *)(0x9000000000000000ull +
+							0x1fbf0000ull + (0x02 ^ 7));
+
+		*cpld_rst &= ~0x02;
+		mb();
+		mdelay(1000);	/* the board resets underneath us */
+	}
+
 	mb();
 	while (1)
 		if (OCTEON_IS_OCTEON3())
