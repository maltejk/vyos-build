From: VyOS SRX kernel build
Subject: octeon: add missing prototypes for mm/cache and helper-errata

arch/mips/mm/c-octeon.c defines register_co_cache_error_notifier,
unregister_co_cache_error_notifier, cache_parity_error_octeon_recoverable
and cache_parity_error_octeon_non_recoverable with no prior prototype, and
arch/mips/cavium-octeon/executive/cvmx-helper-errata.c defines
__cvmx_helper_errata_qlm_disable_2nd_order_cdr likewise; -Werror=missing-prototypes
fails. Add prototypes in asm/c-octeon.h and include it from c-octeon.c; include
asm/octeon/cvmx-helper-errata.h from cvmx-helper-errata.c.

---
 arch/mips/cavium-octeon/executive/cvmx-helper-errata.c | 2 ++
 arch/mips/include/asm/c-octeon.h                       | 9 +++++++++
 arch/mips/mm/c-octeon.c                                | 1 +
 3 files changed, 12 insertions(+)

diff --git a/arch/mips/cavium-octeon/executive/cvmx-helper-errata.c b/arch/mips/cavium-octeon/executive/cvmx-helper-errata.c
--- a/arch/mips/cavium-octeon/executive/cvmx-helper-errata.c
+++ b/arch/mips/cavium-octeon/executive/cvmx-helper-errata.c
@@ -39,6 +39,8 @@

 #include <asm/octeon/cvmx-helper-jtag.h>

+#include <asm/octeon/cvmx-helper-errata.h>
+
 /**
  * Due to errata G-720, the 2nd order CDR circuit on CN52XX pass
  * 1 doesn't work properly. The following code disables 2nd order
diff --git a/arch/mips/include/asm/c-octeon.h b/arch/mips/include/asm/c-octeon.h
new file mode 100644
--- /dev/null
+++ b/arch/mips/include/asm/c-octeon.h
@@ -0,0 +1,9 @@
+#ifndef __C_OCTEON_H__
+#define __C_OCTEON_H__
+
+extern int register_co_cache_error_notifier(struct notifier_block *nb);
+extern int unregister_co_cache_error_notifier(struct notifier_block *nb);
+extern void cache_parity_error_octeon_recoverable(void);
+extern void cache_parity_error_octeon_non_recoverable(void);
+
+#endif
diff --git a/arch/mips/mm/c-octeon.c b/arch/mips/mm/c-octeon.c
--- a/arch/mips/mm/c-octeon.c
+++ b/arch/mips/mm/c-octeon.c
@@ -16,6 +16,7 @@

 #include <asm/bcache.h>
 #include <asm/bootinfo.h>
+#include <asm/c-octeon.h>
 #include <asm/cacheops.h>
 #include <asm/cpu-features.h>
 #include <asm/cpu-type.h>
--
2.39.5

