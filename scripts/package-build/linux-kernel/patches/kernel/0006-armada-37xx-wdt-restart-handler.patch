From: vyos-mox <noreply@example.invalid>
Subject: [PATCH] watchdog: armada_37xx_wdt: use the watchdog as restart handler

A warm reset requested via PSCI hangs the Armada 3720 SoC (Turris Mox) when
called from a running Linux, while watchdog expiry is handled safely by the
secure firmware. Register a high priority restart handler that arms the
watchdog with a 1 second timeout and waits for it to expire. The PSCI handler
remains as a fallback if the watchdog does not reset the system.

Requires the U-Boot environment variable a3720_reset_issue_workaround=yes.

---
--- a/drivers/watchdog/armada_37xx_wdt.c
+++ b/drivers/watchdog/armada_37xx_wdt.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -231,6 +232,29 @@
 	return 0;
 }
 
+/*
+ * A warm reset requested through PSCI can hang the Armada 3720 SoC (hardware
+ * bug, see the CM3_SYSTEM_RESET workaround in Trusted Firmware-A), whereas the
+ * expiry of this watchdog is handled safely by the secure firmware (WTMI, "reset
+ * issue workaround", enabled by U-Boot environment variable
+ * a3720_reset_issue_workaround=yes). Therefore restart the system by arming the
+ * watchdog with the shortest timeout and waiting for it to expire. This handler
+ * must run before the PSCI one (priority 129) and has to start the counters
+ * again, because the reboot notifier stops the watchdog beforehand.
+ */
+static int armada_37xx_wdt_restart(struct watchdog_device *wdt,
+				   unsigned long action, void *data)
+{
+	armada_37xx_wdt_set_timeout(wdt, 1);
+	armada_37xx_wdt_start(wdt);
+
+	/* give the watchdog and the secure firmware time to reset the SoC */
+	mdelay(5000);
+
+	/* if we are still here, let the next restart handler try */
+	return 0;
+}
+
 static const struct watchdog_info armada_37xx_wdt_info = {
 	.options = WDIOF_SETTIMEOUT | WDIOF_KEEPALIVEPING | WDIOF_MAGICCLOSE,
 	.identity = "Armada 37xx Watchdog",
@@ -240,6 +264,7 @@
 	.owner = THIS_MODULE,
 	.start = armada_37xx_wdt_start,
 	.stop = armada_37xx_wdt_stop,
+	.restart = armada_37xx_wdt_restart,
 	.ping = armada_37xx_wdt_ping,
 	.set_timeout = armada_37xx_wdt_set_timeout,
 	.get_timeleft = armada_37xx_wdt_get_timeleft,
@@ -301,6 +326,7 @@
 
 	watchdog_set_nowayout(&dev->wdt, nowayout);
 	watchdog_stop_on_reboot(&dev->wdt);
+	watchdog_set_restart_priority(&dev->wdt, 200);
 	ret = devm_watchdog_register_device(&pdev->dev, &dev->wdt);
 	if (ret)
 		return ret;
