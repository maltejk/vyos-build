#!/usr/bin/env python3
#
# Turris Mox: keep the DSA switch ports out of the hw-id based interface naming.
#
# The eight ports of the Peridot switch module are DSA user ports. They have no
# MAC address of their own (they inherit the one of the CPU port, which is also the
# MAC of the on-board eth9) and their names are fixed by the udev rule
# 71-mox-net-naming.rules (phys_port_name p1..p8). hw-id naming keys on the MAC,
# so with nine interfaces sharing one MAC it renames ports at random and leaves
# e.g. eth2 as "vyeth5". Therefore, on a Turris Mox,
#   - vyos-net-name-resolve.py ignores DSA user ports when it discovers NICs (but
#     still treats their names as taken, otherwise the bootstrap naming of a first
#     boot would try to rename eth9 to the already used name eth1), and
#   - vyos-interface-rescan.py never writes a hw-id for them into config.boot.
# Pending nodes: the flavor's default config has an eth0 node without hw-id (DHCP).
# On a Turris Mox udev already names the onboard ports eth0/eth9, so a candidate that
# carries the name of a pending node is that node's hardware (upstream only matches
# when there is exactly one pending node and exactly one candidate, which is never
# the case with two onboard ports).
# A DSA user port is a device with a backing device whose iflink differs from its
# ifindex (it is a stacked device on the conduit interface).
#
# Exact string replacements: if upstream changes the scripts so that a pattern no
# longer matches, the image build fails here.

import sys

HELPERS = '''def is_turris_mox() -> bool:
    """Detect a Turris Mox by its device tree"""
    try:
        with open('/proc/device-tree/compatible', 'rb') as f:
            return b'cznic,turris-mox' in f.read()
    except OSError:
        return False


def is_mox_dsa_user_port(ifname: str, sys_class_net: str = '/sys/class/net') -> bool:
    """True for a switch port of the Turris Mox (DSA user port: iflink != ifindex)"""
    if not is_turris_mox():
        return False
    try:
        with open(f'{sys_class_net}/{ifname}/iflink') as f:
            iflink = f.read().strip()
        with open(f'{sys_class_net}/{ifname}/ifindex') as f:
            ifindex = f.read().strip()
    except OSError:
        return False
    return iflink != ifindex


def mox_dsa_port_names(sys_class_net: str = '/sys/class/net') -> set:
    """Names of all switch ports of the Turris Mox, they are never free for renaming"""
    if not is_turris_mox():
        return set()
    import os
    return {name for name in os.listdir(sys_class_net)
            if is_mox_dsa_user_port(name, sys_class_net)}


'''

def patch(target, edits):
    try:
        with open(target) as f:
            src = f.read()
    except FileNotFoundError:
        return
    if 'is_mox_dsa_user_port' in src:
        return
    for old, new in edits:
        if src.count(old) != 1:
            sys.exit(f'28-mox-interface-naming: expected exactly one match in {target} for:\n{old}')
        src = src.replace(old, new, 1)
    with open(target, 'w') as f:
        f.write(src)


RESOLVE = '/usr/libexec/vyos/system/vyos-net-name-resolve.py'
RESCAN = '/usr/libexec/vyos/vyos-interface-rescan.py'
if len(sys.argv) > 2:
    RESOLVE, RESCAN = sys.argv[1], sys.argv[2]

patch(RESOLVE, [
    ("def discover_physical_interfaces(sys_class_net: str = '/sys/class/net') -> dict:",
     HELPERS + "def discover_physical_interfaces(sys_class_net: str = '/sys/class/net') -> dict:"),
    ("""        if (entry / 'master').exists():
            logger.debug(
                f"skipping '{entry.name}': interface is enslaved via master link"
            )
            continue
""",
     """        if (entry / 'master').exists():
            logger.debug(
                f"skipping '{entry.name}': interface is enslaved via master link"
            )
            continue
        if is_mox_dsa_user_port(entry.name, sys_class_net):
            logger.debug(
                f"skipping '{entry.name}': Turris Mox switch port, named by udev"
            )
            continue
"""),
    ("    grouped = {'ethernet': [], 'wireless': []}\n",
     """    matched = {}
    if is_turris_mox():
        pending_names = set().union(*pending.values()) if pending else set()
        for mac, name in candidates:
            if name in pending_names:
                matched[mac] = name
                logger.info(f"matching '{name}' to its pending node (named by udev)")
        candidates = [(mac, name) for mac, name in candidates if mac not in matched]
        pending = {kind: nodes - set(matched.values()) for kind, nodes in pending.items()}
    grouped = {'ethernet': [], 'wireless': []}
"""),
    ("    matched = {}\n    for intf_type, nodes in pending.items():\n",
     "    for intf_type, nodes in pending.items():\n"),
    ("            taken = unchanged | set(plan.values()) | set(plan.keys()) | reserved\n",
     "            taken = unchanged | set(plan.values()) | set(plan.keys()) | reserved\n"
     "            taken |= mox_dsa_port_names()\n"),
    ("        | set(rightful_movers.values()) | reserved_pending\n",
     "        | set(rightful_movers.values()) | reserved_pending\n"
     "    taken |= mox_dsa_port_names()\n"),
])

patch(RESCAN, [
    ("def filter_interfaces(intfs: dict) -> dict:",
     HELPERS + "def filter_interfaces(intfs: dict) -> dict:"),
    ("""        if not os.path.isdir(os.path.join('/sys/class/net', intf)):
            continue
""",
     """        if not os.path.isdir(os.path.join('/sys/class/net', intf)):
            continue
        if is_mox_dsa_user_port(intf):
            continue
"""),
])
